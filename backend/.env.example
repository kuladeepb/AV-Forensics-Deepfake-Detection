# Backend environment variables
# Copy to .env and fill in your values

# Set to 0 after uploading model.pth + config.json to enable real inference
MOCK_MODEL=1

# Paths to trained model files (relative to backend/ or absolute)
MODEL_PATH=model.pth
CONFIG_PATH=config.json

# Upload limits
MAX_UPLOAD_MB=50
MAX_DURATION_SEC=30

# Cache duration in seconds (default: 3600 = 1 hour)
CACHE_TTL_SEC=3600

# CORS: comma-separated origins. Use * for open access (not recommended in production).
CORS_ORIGINS=https://av-forensics.vercel.app,http://localhost:5173

