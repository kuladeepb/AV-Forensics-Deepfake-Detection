# ==============================================================================
# AV-Forensics Backend Environment Configuration Template
# Copy this file to .env and adjust variables as needed:
#   copy .env.example .env
# ==============================================================================

# Execution mode: 0 for full PyTorch inference with weights, 1 for mock simulation
MOCK_MODEL=0

# Paths to trained model weights and configuration
MODEL_PATH=backend/model.pth
CONFIG_PATH=backend/config.json

# Server network settings
PORT=8000
HOST=0.0.0.0

# Upload limits
MAX_UPLOAD_MB=50
MAX_DURATION_SEC=60

# Cache duration in seconds (default: 3600 = 1 hour)
CACHE_TTL_SEC=3600

# CORS settings: comma-separated origins. Use * for development
CORS_ORIGINS=*

# Optional: Path to custom evaluation video folder for benchmark tests
TEST_VIDEO_DIR=
