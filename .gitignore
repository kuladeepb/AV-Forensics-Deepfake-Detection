# AV-Forensics git ignore

# Environment & secrets (never commit actual secrets or local envs!)
.env
.env.*
*.env
*.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# Dataset and model weights (too large for git, load locally or via Drive/HF)
*.pth
*.pt
*.bin
*.h5
*.pkl
*.npy
*.npz
*.zip
*.tar.gz
FakeAVCeleb_Dataset/
avforensics_cache/
avforensics_checkpoints/
samples/large/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
ENV/
env/
*.egg-info/
dist/
build/
.pytest_cache/

# Node / frontend
node_modules/
frontend/dist/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
*.local

# IDEs & System
.vscode/
.idea/
*.DS_Store
Thumbs.db

# Temp, logs & forensic reports
/tmp/
*.log
avforensics_reports/

# Jupyter checkpoints
.ipynb_checkpoints/
